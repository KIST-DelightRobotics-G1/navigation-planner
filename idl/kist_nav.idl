// Navigation DDS contract for kist-navigation-planner. Follows the kist ecosystem
// conventions (module kist_msgs, seq / stamp_ns fields, CycloneDDS idlc `-l cxx`
// codegen). Distinct file name (kist_nav.idl -> kist_nav.hpp) so the generated
// header never collides with other repos' kist_msgs.hpp, while the C++ namespace
// stays kist_msgs:: for cross-repo interop.
//
// Topics:
//   "rt/kist/nav/destinations"  NavDestinationList  — this planner PUBLISHES the
//       destination catalog (config/destinations.yaml) so any peer can address a
//       goal by name. Re-published at a low rate for late joiners.
//   "rt/cortex/nav/cmd"    SubtaskCmd    — orchestrator -> nav (RELIABLE, depth 10, event).
//   "rt/cortex/nav/state"  SubtaskState  — nav -> orchestrator (RELIABLE, depth 10, 10 Hz).
//     ("rt/" is the ROS2 topic prefix: ROS2 topic /cortex/nav/cmd == DDS topic rt/cortex/nav/cmd.)
//
// NOTE (ROS2 interop): the orchestrator is ROS2. Header/Time below mirror std_msgs/Header +
// builtin_interfaces/Time by structure. If strict rmw type-name matching is required, align the
// module/type names to the orchestrator's package when their .msg is shared.

module kist_msgs {

    // One named navigation destination: a map-frame goal + the heading to align
    // to on arrival. Mirrors an entry in config/destinations.yaml.
    struct NavDestination {
        string  name;
        float   x;         // world/map frame (m)
        float   y;
        float   yaw_deg;   // finish heading (deg, +x = 0, +y = 90, CCW)
    };

    // The full destination catalog, published so peers share the same set of
    // addressable goals (by name) as this planner.
    struct NavDestinationList {
        unsigned long long        seq;          // publisher-wide monotonic counter
        long long                 stamp_ns;     // publish clock (epoch ns)
        sequence<NavDestination>  destinations;
    };

    // ── cortex orchestrator contract (shared with the VLA module) ─────────────────
    // builtin_interfaces/Time (int32 sec, uint32 nanosec).
    struct Time {
        long          sec;
        unsigned long nanosec;
    };

    // std_msgs/Header (stamp + frame_id).
    struct Header {
        Time   stamp;
        string frame_id;
    };

    // Orchestrator -> module (rt/cortex/nav/cmd): one subtask of a plan. nav handles action
    // "move_to" only (VLA handles open/pick/place/handover/...); other actions are ignored here.
    struct SubtaskCmd {
        string           plan_id;      // plan id, e.g. "p-1758351012-0007"
        unsigned short   index;        // subtask index within the plan (from 0)
        string           action;       // semantic action; nav uses "move_to"
        sequence<string> args;         // validated vocabulary args; move_to -> ["fridge"]
        string           instruction;  // VLA-only English instruction; empty for nav
        boolean          cancel;       // true = cancel (plan_id, index); action/args ignored
    };

    // Module -> orchestrator (rt/cortex/nav/state), 10 Hz. Reports the subtask being executed.
    //   status: 0 IDLE (no subtask), 1 RUNNING, 2 DONE, 3 FAILED.
    //   progress: 0..1 (nav: 1 - remaining/initial distance). note: human-readable
    //   ("" normal; "cancelled"; "no path"/"unsupported: ..." on FAILED — see the contract).
    struct SubtaskState {
        Header         header;         // header.stamp = publish time (freshness / stale check)
        string         plan_id;        // reported plan; "" when IDLE
        unsigned short index;          // reported subtask index; 0 when IDLE
        string         action;         // reported action (as received)
        octet          status;         // see the enumeration above
        float          progress;       // 0..1 (debug)
        string         note;           // human-readable detail
    };

};
