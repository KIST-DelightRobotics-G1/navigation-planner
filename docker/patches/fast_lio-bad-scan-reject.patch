+double reject_corr_rot_rad = 0.20;   // per-scan correction cap (rad, ~11 deg)
+int    reject_min_feats    = 50;     // too few matched points -> degenerate scan
+double reject_max_res_m    = 0.50;   // mean point-to-plane residual cap (m)
+int    reject_warn_streak  = 10;     // warn every N consecutive rejects
+long   reject_total = 0, reject_streak = 0;
